{
  "name": "knapsack_01",
  "difficulty": "hard",
  "statement": "Implement knapsack_01(weights, values, capacity), returning the maximum total value using each item at most once without exceeding capacity. weights and values have equal length; all weights are positive. Return 0 if no item fits. Aim for O(n*capacity) time.",
  "tests": [
    {
      "args": [
        [
          1,
          3,
          4,
          5
        ],
        [
          1,
          4,
          5,
          7
        ],
        7
      ],
      "expected": 9,
      "category": "canonical_knapsack"
    },
    {
      "args": [
        [
          2,
          3,
          4
        ],
        [
          4,
          5,
          6
        ],
        5
      ],
      "expected": 9,
      "category": "capacity_constraint"
    },
    {
      "args": [
        [
          5,
          6
        ],
        [
          10,
          12
        ],
        3
      ],
      "expected": 0,
      "category": "no_item_fits"
    },
    {
      "args": [
        [],
        [],
        10
      ],
      "expected": 0,
      "category": "empty_items"
    },
    {
      "args": [
        [
          1,
          2,
          3
        ],
        [
          6,
          10,
          12
        ],
        5
      ],
      "expected": 22,
      "category": "optimal_combination"
    },
    {
      "args": [
        [
          2,
          2,
          2
        ],
        [
          3,
          4,
          5
        ],
        4
      ],
      "expected": 9,
      "category": "duplicate_weights"
    },
    {
      "args": [
        [
          1
        ],
        [
          100
        ],
        0
      ],
      "expected": 0,
      "category": "zero_capacity"
    }
  ],
  "bug_family": "zero_one_dynamic_programming",
  "bug_patterns": [
    "forward iteration reuses item",
    "capacity boundary",
    "incorrect max transition",
    "empty input"
  ],
  "difficulty_rubric": "Hard: 0/1 state transition and iteration direction"
}
