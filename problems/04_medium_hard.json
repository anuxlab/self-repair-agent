{
  "name": "max_subarray",
  "difficulty": "medium-hard",
  "statement": "Implement max_subarray(nums), returning the maximum sum of any non-empty contiguous subarray. Input is non-empty. Handle all-negative arrays correctly. Aim for O(n) time.",
  "tests": [
    {
      "args": [
        [
          -2,
          1,
          -3,
          4,
          -1,
          2,
          1,
          -5,
          4
        ]
      ],
      "expected": 6
    },
    {
      "args": [
        [
          1
        ]
      ],
      "expected": 1
    },
    {
      "args": [
        [
          -3,
          -1,
          -2
        ]
      ],
      "expected": -1
    },
    {
      "args": [
        [
          5,
          4,
          -1,
          7,
          8
        ]
      ],
      "expected": 23
    },
    {
      "args": [
        [
          0,
          0,
          0
        ]
      ],
      "expected": 0
    },
    {
      "args": [
        [
          -2,
          -1
        ]
      ],
      "expected": -1
    }
  ]
}
