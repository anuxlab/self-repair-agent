{
  "name": "max_subarray",
  "difficulty": "medium-hard",
  "statement": "Implement max_subarray(nums), returning the maximum sum of any non-empty contiguous subarray. Input is non-empty. Handle all-negative arrays correctly. Aim for O(n) time.",
  "tests": [
    {
      "args": [
        [
          -2,
          1,
          -3,
          4,
          -1,
          2,
          1,
          -5,
          4
        ]
      ],
      "expected": 6,
      "category": "mixed_positive_negative"
    },
    {
      "args": [
        [
          1
        ]
      ],
      "expected": 1,
      "category": "single_element_boundary"
    },
    {
      "args": [
        [
          -3,
          -1,
          -2
        ]
      ],
      "expected": -1,
      "category": "all_negative_boundary"
    },
    {
      "args": [
        [
          5,
          4,
          -1,
          7,
          8
        ]
      ],
      "expected": 23,
      "category": "all_positive_run"
    },
    {
      "args": [
        [
          0,
          0,
          0
        ]
      ],
      "expected": 0,
      "category": "all_zero_boundary"
    },
    {
      "args": [
        [
          -2,
          -1
        ]
      ],
      "expected": -1,
      "category": "all_negative_boundary"
    }
  ],
  "bug_family": "dynamic_programming_and_boundaries",
  "bug_patterns": [
    "incorrect recurrence",
    "all-negative initialization bug",
    "empty/non-empty assumption error",
    "off-by-one boundary error"
  ],
  "difficulty_rubric": "State invariant and tricky negative/boundary cases"
}
