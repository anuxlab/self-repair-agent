{
  "name": "coin_change",
  "difficulty": "medium",
  "statement": "Implement coin_change(coins, amount). Return the minimum number of coins needed to make amount using unlimited copies of positive coin denominations, or -1 if impossible. Return 0 for amount 0. Aim for O(len(coins)*amount) time.",
  "tests": [
    {
      "args": [
        [
          1,
          2,
          5
        ],
        11
      ],
      "expected": 3,
      "category": "canonical_dp"
    },
    {
      "args": [
        [
          2
        ],
        3
      ],
      "expected": -1,
      "category": "unreachable_amount"
    },
    {
      "args": [
        [
          1
        ],
        0
      ],
      "expected": 0,
      "category": "zero_amount"
    },
    {
      "args": [
        [
          1,
          3,
          4
        ],
        6
      ],
      "expected": 2,
      "category": "non_greedy_optimum"
    },
    {
      "args": [
        [
          2,
          5,
          10,
          1
        ],
        27
      ],
      "expected": 4,
      "category": "larger_amount"
    },
    {
      "args": [
        [
          3,
          7
        ],
        5
      ],
      "expected": -1,
      "category": "gcd_unreachable"
    }
  ],
  "bug_family": "dynamic_programming",
  "bug_patterns": [
    "greedy instead of optimal DP",
    "unreachable state initialization",
    "zero amount boundary",
    "off-by-one amount indexing"
  ],
  "difficulty_rubric": "Medium: recurrence and unreachable states"
}
