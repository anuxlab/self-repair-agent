{
  "name": "is_palindrome",
  "difficulty": "easy-medium",
  "statement": "Implement is_palindrome(s). Return True when s is a palindrome, ignoring case and all non-alphanumeric characters; otherwise False.",
  "tests": [
    {
      "args": [
        "A man, a plan, a canal: Panama"
      ],
      "expected": true,
      "category": "case_and_punctuation_normalization"
    },
    {
      "args": [
        "race a car"
      ],
      "expected": false,
      "category": "ordinary_negative_case"
    },
    {
      "args": [
        ""
      ],
      "expected": true,
      "category": "empty_input_boundary"
    },
    {
      "args": [
        ".,!?"
      ],
      "expected": true,
      "category": "punctuation_only_boundary"
    },
    {
      "args": [
        "No lemon, no melon"
      ],
      "expected": true,
      "category": "normalization_variant"
    },
    {
      "args": [
        "ab"
      ],
      "expected": false,
      "category": "short_input_boundary"
    }
  ],
  "bug_family": "string_normalization",
  "bug_patterns": [
    "case sensitivity",
    "punctuation handling",
    "empty input",
    "incorrect string normalization"
  ],
  "difficulty_rubric": "Normalization rules and edge cases"
}
