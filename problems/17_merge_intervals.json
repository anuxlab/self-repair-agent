{
  "name": "merge_intervals",
  "difficulty": "medium",
  "statement": "Implement merge_intervals(intervals), merging all overlapping or touching closed intervals [start,end]. Return the merged intervals sorted by start. Empty input returns an empty list. For touching intervals [1,2] and [2,3], merge them.",
  "tests": [
    {
      "args": [
        [
          [
            1,
            3
          ],
          [
            2,
            6
          ],
          [
            8,
            10
          ],
          [
            15,
            18
          ]
        ]
      ],
      "expected": [
        [
          1,
          6
        ],
        [
          8,
          10
        ],
        [
          15,
          18
        ]
      ],
      "category": "canonical_merge"
    },
    {
      "args": [
        []
      ],
      "expected": [],
      "category": "empty_input"
    },
    {
      "args": [
        [
          [
            1,
            4
          ],
          [
            4,
            5
          ]
        ]
      ],
      "expected": [
        [
          1,
          5
        ]
      ],
      "category": "touching_intervals"
    },
    {
      "args": [
        [
          [
            1,
            4
          ],
          [
            2,
            3
          ]
        ]
      ],
      "expected": [
        [
          1,
          4
        ]
      ],
      "category": "nested_interval"
    },
    {
      "args": [
        [
          [
            5,
            7
          ],
          [
            1,
            2
          ],
          [
            2,
            4
          ]
        ]
      ],
      "expected": [
        [
          1,
          4
        ],
        [
          5,
          7
        ]
      ],
      "category": "unsorted_input"
    },
    {
      "args": [
        [
          [
            1,
            2
          ]
        ]
      ],
      "expected": [
        [
          1,
          2
        ]
      ],
      "category": "single_interval"
    }
  ],
  "bug_family": "sorting_and_interval_invariants",
  "bug_patterns": [
    "sorting by wrong field",
    "touching interval semantics",
    "nested interval truncation",
    "empty input"
  ],
  "difficulty_rubric": "Medium: sort then maintain merged interval invariant"
}
