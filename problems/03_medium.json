{
  "name": "two_sum",
  "difficulty": "medium",
  "statement": "Implement two_sum(nums, target), returning the indices of two distinct elements whose values sum to target. Exactly one solution exists. Return the two indices in any order. Aim for O(n) time.",
  "tests": [
    {
      "args": [
        [
          2,
          7,
          11,
          15
        ],
        9
      ],
      "expected": [
        0,
        1
      ],
      "unordered_list": true,
      "category": "basic_pair"
    },
    {
      "args": [
        [
          3,
          2,
          4
        ],
        6
      ],
      "expected": [
        1,
        2
      ],
      "unordered_list": true,
      "category": "pair_not_at_start"
    },
    {
      "args": [
        [
          3,
          3
        ],
        6
      ],
      "expected": [
        0,
        1
      ],
      "unordered_list": true,
      "category": "duplicate_values"
    },
    {
      "args": [
        [
          -3,
          4,
          3,
          90
        ],
        0
      ],
      "expected": [
        0,
        2
      ],
      "unordered_list": true,
      "category": "negative_values"
    },
    {
      "args": [
        [
          0,
          4,
          3,
          0
        ],
        0
      ],
      "expected": [
        0,
        3
      ],
      "unordered_list": true,
      "category": "duplicate_zero_values"
    }
  ],
  "bug_family": "hashing_and_indexing",
  "bug_patterns": [
    "incorrect complement lookup",
    "duplicate handling",
    "indexing mistakes",
    "negative-value handling",
    "quadratic or inefficient approach (not performance-tested)"
  ],
  "difficulty_rubric": "Algorithmic pattern plus indexing/duplicate handling"
}
