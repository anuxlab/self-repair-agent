{
  "name": "network_delay_time",
  "difficulty": "hard",
  "statement": "Implement network_delay_time(times, n, k). Each directed edge in times is [u,v,w] with vertices numbered 1..n and non-negative travel time w. Return the time for a signal from k to reach every vertex, i.e. the maximum shortest-path distance, or -1 if any vertex is unreachable.",
  "tests": [
    {
      "args": [
        [
          [
            2,
            1,
            1
          ],
          [
            2,
            3,
            1
          ],
          [
            3,
            4,
            1
          ]
        ],
        4,
        2
      ],
      "expected": 2,
      "category": "canonical_directed_dijkstra"
    },
    {
      "args": [
        [
          [
            1,
            2,
            1
          ]
        ],
        2,
        1
      ],
      "expected": 1,
      "category": "simple_edge"
    },
    {
      "args": [
        [
          [
            1,
            2,
            1
          ]
        ],
        3,
        1
      ],
      "expected": -1,
      "category": "unreachable_vertex"
    },
    {
      "args": [
        [
          [
            1,
            2,
            1
          ],
          [
            1,
            2,
            5
          ],
          [
            2,
            3,
            2
          ]
        ],
        3,
        1
      ],
      "expected": 3,
      "category": "parallel_edges"
    },
    {
      "args": [
        [],
        1,
        1
      ],
      "expected": 0,
      "category": "single_vertex"
    },
    {
      "args": [
        [
          [
            1,
            2,
            10
          ],
          [
            1,
            3,
            1
          ],
          [
            3,
            2,
            1
          ]
        ],
        3,
        1
      ],
      "expected": 2,
      "category": "indirect_shorter_path"
    }
  ],
  "bug_family": "directed_weighted_shortest_path",
  "bug_patterns": [
    "max distance vs sum",
    "directed edge handling",
    "unreachable node handling",
    "stale heap entries"
  ],
  "difficulty_rubric": "Hard: shortest paths plus global reachability condition"
}
