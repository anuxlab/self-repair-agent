{
  "name": "trap_rain_water",
  "difficulty": "hard",
  "statement": "Implement trap_rain_water(height), returning the total trapped rainwater for non-negative bar heights. Empty and short lists return zero. Aim for O(n) time and O(1) extra space if practical.",
  "tests": [
    {
      "args": [
        [
          0,
          1,
          0,
          2,
          1,
          0,
          1,
          3,
          2,
          1,
          2,
          1
        ]
      ],
      "expected": 6,
      "category": "canonical_example"
    },
    {
      "args": [
        [
          4,
          2,
          0,
          3,
          2,
          5
        ]
      ],
      "expected": 9,
      "category": "uneven_basins"
    },
    {
      "args": [
        []
      ],
      "expected": 0,
      "category": "empty_input_boundary"
    },
    {
      "args": [
        [
          1
        ]
      ],
      "expected": 0,
      "category": "single_element_boundary"
    },
    {
      "args": [
        [
          3,
          3,
          3
        ]
      ],
      "expected": 0,
      "category": "flat_profile"
    },
    {
      "args": [
        [
          5,
          4,
          1,
          2
        ]
      ],
      "expected": 1,
      "category": "right_boundary_basin"
    },
    {
      "args": [
        [
          2,
          0,
          2
        ]
      ],
      "expected": 2,
      "category": "single_basin"
    },
    {
      "args": [
        [
          0,
          2,
          0,
          2
        ]
      ],
      "expected": 2,
      "category": "multiple_basins"
    }
  ],
  "bug_family": "two_pointer_invariant_and_boundaries",
  "bug_patterns": [
    "two-pointer invariant error",
    "incorrect water accumulation",
    "boundary handling",
    "empty/short input bug",
    "overcounting or undercounting"
  ],
  "difficulty_rubric": "Multi-step invariant reasoning and adversarial boundaries"
}
