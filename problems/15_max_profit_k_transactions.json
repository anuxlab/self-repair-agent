{
  "name": "max_profit_k_transactions",
  "difficulty": "hard",
  "statement": "Implement max_profit_k_transactions(k, prices), returning the maximum stock-trading profit using at most k buy/sell transactions. You may hold at most one share at a time and must sell before buying again. Return 0 for empty prices or k=0. For k >= len(prices)//2, an unlimited-transactions solution is acceptable.",
  "tests": [
    {
      "args": [
        2,
        [
          2,
          4,
          1
        ]
      ],
      "expected": 2,
      "category": "canonical_dp"
    },
    {
      "args": [
        2,
        [
          3,
          2,
          6,
          5,
          0,
          3
        ]
      ],
      "expected": 7,
      "category": "multiple_transactions"
    },
    {
      "args": [
        0,
        [
          1,
          3,
          2,
          8
        ]
      ],
      "expected": 0,
      "category": "zero_transactions"
    },
    {
      "args": [
        3,
        []
      ],
      "expected": 0,
      "category": "empty_prices"
    },
    {
      "args": [
        1,
        [
          7,
          1,
          5,
          3,
          6,
          4
        ]
      ],
      "expected": 5,
      "category": "single_transaction"
    },
    {
      "args": [
        2,
        [
          1,
          2,
          3,
          4,
          5
        ]
      ],
      "expected": 4,
      "category": "unlimited_fast_path"
    },
    {
      "args": [
        2,
        [
          7,
          6,
          4,
          3,
          1
        ]
      ],
      "expected": 0,
      "category": "monotone_decreasing"
    }
  ],
  "bug_family": "state_machine_dynamic_programming",
  "bug_patterns": [
    "buy/sell state update order",
    "transaction count off by one",
    "unlimited transactions fast path",
    "negative profit"
  ],
  "difficulty_rubric": "Hard: constrained state transitions and transaction accounting"
}
